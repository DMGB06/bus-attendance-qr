{
  "expo": {
    "name": "CerroBus",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.dmgb.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "static",
      "themeColor": "#1C3284",
      "backgroundColor": "#1C3284",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "es",
      "description": "CerroBus - Sistema de transporte escolar y monitoreo",
      "manifest": {
        "name": "Bus Mdca",
        "short_name": "Bus Mdca",
        "icons": [
          {
            "src": "./assets/images/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "./assets/images/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
          }
        ]
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#1C3284",
          "dark": {
            "backgroundColor": "#152766"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1C3284"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CerroBus necesita tu ubicación mientras conduces para que los apoderados vean la ruta aproximada del bus.",
          "locationAlwaysAndWhenInUsePermission": "CerroBus usa tu ubicación solo durante el viaje activo para informar a los apoderados.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa36d247-5ff6-4ab3-bc86-ca36fa014905"
      }
    },
    "owner": "dmgb"
  }
}